# Não edite este arquivo para guardar segredos. Rode `make env`: ele cria o .env a partir daqui,
# preenchendo com valores aleatórios tudo o que está vazio e marcado como segredo.
# Nunca versione o .env.

APP_ENV=development            # development | test | production (no servidor: production)
LOG_LEVEL=INFO
TZ=America/Sao_Paulo

# --- Docker Compose ---
# Profiles ligados. Local: só o banco (a API roda com `make dev`).
# Servidor: app,proxy,n8n
COMPOSE_PROFILES=n8n

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_DB=rag_ingestao
POSTGRES_PASSWORD=             # segredo (gerado)
DB_PORT=5432
# Usada pela API rodando fora do Docker (make dev). Gerada a partir dos valores acima.
DATABASE_URL=

# --- API ---
# Obrigatória (16+ caracteres) em produção.
API_KEY=                       # segredo (gerado)

# --- Servidor (profile proxy) ---
# Sem domínio próprio, use um nome que aponta para o IP, como api.SEU-IP.sslip.io.
DOMAIN=localhost

# --- n8n ---
N8N_DB_PASSWORD=               # segredo (gerado)
N8N_ENCRYPTION_KEY=            # segredo (gerado). Guarde uma cópia: sem ela, as credenciais salvas se perdem.
# Local: http://localhost:5678. No servidor: https://n8n.SEU-DOMINIO
N8N_URL=http://localhost:5678
N8N_SECURE_COOKIE=false        # true no servidor (HTTPS)
# N8N_VERSION=                 # fixe uma versão depois do primeiro teste

# --- RAG: embeddings e ingestão ---
# simulado (testes, sem modelo) | local (fastembed em CPU; baixa ~220 MB na primeira vez)
EMBEDDINGS_PROVIDER=local
# Geração da resposta: simulado (testes) | ollama (modelo local; o Ollama precisa estar rodando).
LLM_PROVIDER=ollama
# Nome do modelo, como aparece em `ollama list` (ex.: o que você baixou com `ollama pull`).
LLM_MODEL=
# LLM_BASE_URL=http://127.0.0.1:11434
# Parâmetros da busca (valores padrão). O limiar ainda não foi calibrado com o modelo real.
# CONSULTA_K=5
# LIMIAR_SIMILARIDADE=0.25
# Opcional: token gratuito do Hugging Face, contra o erro 429 ao baixar o modelo (Compose usa).
# Fora do Docker, defina na janela do terminal: $env:HF_TOKEN = "hf_..."
# HF_TOKEN=
# Limites de entrada e tamanho dos trechos (valores padrão; descomente para mudar).
# TAMANHO_MAX_MB=20
# MAX_PAGINAS=500
# TAMANHO_TRECHO=500
# SOBREPOSICAO_TRECHO=80
# Ao subir, retoma documentos que ficaram 'pendente' (servidor reiniciado no meio).
# RETOMAR_PENDENTES=true
# Onde o n8n encontra a API. Local (API com uvicorn no seu computador): host.docker.internal.
# Com o profile app (API no Compose), apague esta linha ou use http://api:8000.
RAG_API_URL=http://host.docker.internal:8000
